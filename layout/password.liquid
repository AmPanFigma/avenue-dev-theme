<!doctype html>

<html lang="en">

<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Shopify Status — Static study</title>

<style>

/* 1. Design tokens and reset */

:root{--background:#f6f6f7;--ink:#202223;--muted:#8c9196;--service:#6d7175;--green:#78b657;--line:#dedfe1}

*{box-sizing:border-box}body{margin:0;background:var(--background);color:var(--ink);font-family:Arial,Helvetica,sans-serif;font-size:16px}a{color:inherit}svg{display:inline-block;vertical-align:middle;flex-shrink:0}

/* 2. Header: inset slightly further than the content grid */

header{width:83.75%;margin:auto;height:88px;display:flex;align-items:center;justify-content:space-between}header img{display:block;width:200px;height:auto}header a{font-size:18px;font-weight:600;text-decoration:none}

/* 3. Overall status */

main{width:87.65%;margin:auto;text-align:center}.hero{padding-top:75px}.hero>.check{width:80px;height:64px;color:var(--green)}h1{font-size:48px;line-height:1.2;letter-spacing:-1.35px;margin:37px 0 39px;font-weight:700}.detail{font-size:18px;line-height:26px;margin:0;color:#111}

/* 4. Status legend */

.legend{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:34px;margin:33px 0 35px;color:var(--muted);list-style:none;padding:0}.legend li{display:flex;align-items:center;gap:10px;white-space:nowrap}.legend svg,.services svg{width:16px;height:16px}.operational{color:var(--green)}

/* 5. Three-column service matrix; no vertical separators */

.services{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:#fff;border-radius:3px;overflow:hidden;box-shadow:0 2px 4px #00000012;text-align:left}.services li{display:flex;align-items:center;gap:6px;min-height:62px;padding:18px 23px;color:var(--service);font-weight:600;font-size:16px;border-bottom:1px solid var(--line)}.services li:nth-last-child(-n+3){border-bottom:0}

/* 6. Footer and responsive behavior */

footer{margin:33px 0 45px;color:var(--muted);line-height:26px}footer p{margin:0}footer a{font-weight:600}.study{position:fixed;bottom:8px;right:12px;font-size:10px;color:#8c9196}

@media(max-width:760px){header{width:90%;height:76px}header img{width:160px}header a{font-size:14px}main{width:90%}.hero{padding-top:40px}h1{font-size:34px;margin:24px 0}.detail{font-size:16px}.legend{gap:12px 20px;margin:24px 0}.services{grid-template-columns:1fr}.services li:nth-last-child(-n+3){border-bottom:1px solid var(--line)}.services li:last-child{border-bottom:0}footer{font-size:14px}}

</style>
<meta name="robots" content="noindex, nofollow">
{{ content_for_header }}
</head><body>

<!-- SVG symbols are defined once, then reused throughout the page. -->

<svg xmlns="http://www.w3.org/2000/svg" style="position:absolute;width:0;height:0" aria-hidden="true"><symbol id="check" viewBox="0 0 24 20"><path d="M3 9.5l6 6L21 3.5" fill="none" stroke="currentColor" stroke-width="5.2" stroke-linecap="round" stroke-linejoin="round"/></symbol><symbol id="minus" viewBox="0 0 16 16"><rect x="2" y="2" width="12" height="12" rx="3" fill="#eab308"/><path d="M5 8h6" stroke="white" stroke-width="2"/></symbol><symbol id="warning" viewBox="0 0 16 16"><path d="M8 1L16 15H0Z" fill="#b85d0a"/><path d="M8 5v5m0 2v1" stroke="white" stroke-width="1.8"/></symbol><symbol id="cross" viewBox="0 0 16 16"><path d="m4 4 8 8m0-8-8 8" stroke="#df2818" stroke-width="3"/></symbol><symbol id="wrench" viewBox="0 0 16 16"><path fill="#3498db" d="M14 1a5 5 0 0 0-6 6l-7 6a2 2 0 0 0 3 3l6-7a5 5 0 0 0 6-6l-4 3-2-2z"/></symbol></svg>

<header><img src="data:image/png;base64," alt="Shopify Status"></header>

<main><section class="hero"><svg class="operational" aria-hidden="true"><use href="#warning"/></svg><h1>Errors at Online Store Checkout</h1></section>

<ul class="legend" aria-label="Status legend"><li><svg class="operational" aria-hidden="true"><use href="#check"/></svg>Operational</li>

<li><svg class="operational" aria-hidden="true"><use href="#minus"/></svg>Degraded Performance</li>

<li><svg class="operational" aria-hidden="true"><use href="#warning"/></svg>Partial Outage</li>

<li><svg class="operational" aria-hidden="true"><use href="#cross"/></svg>Major Outage</li>

<li><svg class="operational" aria-hidden="true"><use href="#wrench"/></svg>Maintenance</li></ul>

<ul class="services" aria-label="Illustrative service statuses"><li><svg class="operational" aria-hidden="true"><use href="#check"/></svg><span>Admin</span></li>

<li><svg class="operational" aria-hidden="true"><use href="#check"/></svg><span>Checkout</span></li>

<li><svg class="operational" aria-hidden="true"><use href="#check"/></svg><span>Reports and Dashboards</span></li>

<li><svg class="operational" aria-hidden="true"><use href="#warning"/></svg><span>Storefront</span></li>

<li><svg class="operational" aria-hidden="true"><use href="#warning"/></svg><span>API &amp; Mobile</span></li>

<li><svg class="operational" aria-hidden="true"><use href="#check"/></svg><span>Third party services</span></li>

<li><svg class="operational" aria-hidden="true"><use href="#check"/></svg><span>Support</span></li>

<li><svg class="operational" aria-hidden="true"><use href="#check"/></svg><span>Point of Sale</span></li>

<li><svg class="operational" aria-hidden="true"><use href="#check"/></svg><span>Oxygen</span></li></ul>

<footer><p>Some issues affecting a small percentage of stores may not be reflected here.</p><p>Having trouble? <a href="https://help.shopify.com/">Contact support</a></p></footer></main>
<div hidden>{{ content_for_layout }}</div>
</body></html>