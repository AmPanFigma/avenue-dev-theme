<section class="services">
    <div class="container-fluid">
        <div class="heading split">
            <div class="subheading">
                <p>{{ section.settings.highlight }}</p>
            </div>
            <h2><span></span>{{ section.settings.heading }}</h2>
        </div>
        <div class="service-in">
            <div class="service-tabs">
                <div class="tabs-wrapper">
                    <div class="tabs-nav">
                        {% for block in section.blocks %}
                        <button
                            class="tab-button {% if forloop.first %}active{% endif %}"
                            data-tab="{{ block.id }}"
                            {{ block.shopify_attributes }}
                        >
                            {{ block.settings.tab_title }}
                        </button>
                        {% endfor %}
                    </div>

                    <div class="tabs-content">
                        {% for block in section.blocks %}
                        <div class="tab-panel {% if forloop.first %}active{% endif %}" id="{{ block.id }}">
                            <div class="tabcontent-in">
                                <div class="tbci-left">
                                    <div class="tbc-left-top">
                                        <h4>{{ block.settings.tab_title }}</h4>
                                        <p>{{ block.settings.tab_content }}</p>
                                    </div>
                                    <div class="tbc-left-bottom">
                                        <a href="{{ block.settings.button_link | default: '#' }}" class="custom-btn grey">{{ block.settings.button_text }}</a>    
                                    </div>
                                </div>
                                <div class="tbci-right">
                                    <img src="{{ block.settings.tab-image | image_url }}" alt="{{ block.settings.tab_alt_image }}">
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
    
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const tabsWrapper = document.querySelector('.tabs-wrapper');

  if (!tabsWrapper) return;

  const buttons = tabsWrapper.querySelectorAll('.tab-button');
  const panels = tabsWrapper.querySelectorAll('.tab-panel');

  buttons.forEach(button => {
    button.addEventListener('click', function () {
      const target = this.getAttribute('data-tab');

      buttons.forEach(btn => btn.classList.remove('active'));
      panels.forEach(panel => panel.classList.remove('active'));

      this.classList.add('active');

      const targetPanel = tabsWrapper.querySelector('#' + target);

      if (targetPanel) {
        targetPanel.classList.add('active');
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "Services",
  "settings": [
    {
      "type": "text",
      "id": "highlight",
      "label": "Highlight Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
            "type": "text",
            "id": "tab_title",
            "label": "Tab Title",
            "default": "Tab Title"
        },
        {
          "type": "richtext",
          "id": "tab_content",
          "label": "Tab Content"
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Button Label"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "Button Link"
        },
        {
            "type": "image_picker",
            "id": "tab-image",
            "label": "Choose Tab Image"
        },
        {
            "type": "text",
            "id": "tab_alt_image",
            "label": "Add image alt text",
            "default": "Tab Image"
        }
      ]
    }
  ],
  "presets": [
    { "name": "Services" }
  ]
}
{% endschema %}
