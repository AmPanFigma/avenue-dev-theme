<section class="faq-section"{% if section.settings.bg_color != blank %} style="background-color: {{ section.settings.bg_color }};"{% endif %}>
    <div class="container">
        <div class="faq-in">

            <div class="faq-left">
                <div class="heading">
                    {% if section.settings.highlight != blank %}
                        <div class="subheading">
                            <p>{{ section.settings.highlight }}</p>
                        </div>
                    {% endif %}
                    {% if section.settings.heading != blank %}
                        <h2>{{ section.settings.heading }}</h2>
                    {% endif %}
                </div>
                {% if section.settings.footer_text != blank %}
                    <div class="faq-foot">{{ section.settings.footer_text }}</div>
                {% endif %}
            </div>

            <div class="faq-right">
                {% for block in section.blocks %}
                    <div class="faq-item {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }}>
                        <button class="faq-q" type="button" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
                            <span>{{ block.settings.question }}</span>
                            <span class="faq-icon" aria-hidden="true"></span>
                        </button>
                        <div class="faq-a">
                            <div class="faq-a-in">{{ block.settings.answer }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>

        </div>
    </div>
</section>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    var items = Array.prototype.slice.call(section.querySelectorAll('.faq-item'));
    section.addEventListener('click', function (e) {
      var btn = e.target.closest('.faq-q');
      if (!btn) return;
      var item = btn.closest('.faq-item');
      var isOpen = item.classList.contains('active');
      // close all
      items.forEach(function (i) {
        i.classList.remove('active');
        i.querySelector('.faq-q').setAttribute('aria-expanded', 'false');
      });
      // open the clicked one (unless it was already open)
      if (!isOpen) {
        item.classList.add('active');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  })();
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F8F7F3"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Highlight Text",
      "default": "Frequently Asked"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Common Concerns"
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "<p>Don't see what you're looking for here? Get in touch with us here.</p>"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" },
        { "type": "faq_item" },
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}
