<section class="team-main">
    <div class="container-fluid">
        <div class="team-main-in">
            {% for block in section.blocks %}
                <div class="team-main-item {% cycle 'is-image-left', 'is-image-right' %}" {{ block.shopify_attributes }}>

                    <div class="tmi-image">
                        {% if block.settings.image != blank %}
                            <img src="{{ block.settings.image | image_url: width: 1000 }}"
                                 alt="{{ block.settings.name | escape }}"
                                 width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"
                                 loading="lazy">
                        {% endif %}
                    </div>

                    <div class="tmi-content">
                        {% if block.settings.name != blank %}
                            <h3 class="tmi-name">{{ block.settings.name }}</h3>
                        {% endif %}
                        {% if block.settings.designation != blank %}
                            <p class="tmi-desig">{{ block.settings.designation }}</p>
                        {% endif %}
                        {% if block.settings.details != blank %}
                            <div class="tmi-details">{{ block.settings.details }}</div>
                        {% endif %}

                        {% assign has_social = false %}
                        {% if block.settings.linkedin != blank or block.settings.instagram != blank or block.settings.facebook != blank %}
                            {% assign has_social = true %}
                        {% endif %}

                        {% if has_social %}
                            <div class="tmi-social">
                                <span class="tmi-social-label">{{ block.settings.social_label | default: 'Connect on :' }}</span>
                                <ul class="tmi-social-list">
                                    {% if block.settings.linkedin != blank %}
                                        <li>
                                            <a href="{{ block.settings.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
                                                {%- render 'icon-linkedin' -%}
                                            </a>
                                    </li>
                                    {% endif %}
                                    {% if block.settings.instagram != blank %}
                                        <li><a href="{{ block.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
                                            {%- render 'icon-instagram' -%}
                                        </a></li>
                                    {% endif %}
                                    {% if block.settings.facebook != blank %}
                                        <li><a href="{{ block.settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
                                            {%- render 'icon-facebook' -%}
                                        </a></li>
                                    {% endif %}
                                </ul>
                            </div>
                        {% endif %}
                    </div>

                </div>
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Team Main",
  "blocks": [
    {
      "type": "member",
      "name": "Team Member",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "designation", "label": "Designation" },
        { "type": "richtext", "id": "details", "label": "Details" },
        { "type": "header", "content": "Social" },
        { "type": "text", "id": "social_label", "label": "Social label", "default": "Connect on :" },
        { "type": "url", "id": "linkedin", "label": "LinkedIn URL" },
        { "type": "url", "id": "instagram", "label": "Instagram URL" },
        { "type": "url", "id": "facebook", "label": "Facebook URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team Main",
      "blocks": [
        { "type": "member" },
        { "type": "member" }
      ]
    }
  ]
}
{% endschema %}
