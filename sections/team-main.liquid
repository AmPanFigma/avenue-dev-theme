<section class="team-main">
    <div class="container-fluid">
        <div class="team-main-in">
            {% for block in section.blocks %}
                <div class="team-main-item {% cycle 'is-image-left', 'is-image-right' %}" {{ block.shopify_attributes }}>

                    <div class="tmi-image">
                        {% if block.settings.image != blank %}
                            <img src="{{ block.settings.image | image_url: width: 1000 }}"
                                 alt="{{ block.settings.name | escape }}"
                                 width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"
                                 loading="lazy">
                        {% endif %}
                    </div>

                    <div class="tmi-content">
                        {% if block.settings.name != blank %}
                            <h3 class="tmi-name">{{ block.settings.name }}</h3>
                        {% endif %}
                        {% if block.settings.designation != blank %}
                            <p class="tmi-desig">{{ block.settings.designation }}</p>
                        {% endif %}
                        {% if block.settings.details != blank %}
                            <div class="tmi-details">{{ block.settings.details }}</div>
                        {% endif %}

                        {% assign has_social = false %}
                        {% if block.settings.linkedin != blank or block.settings.instagram != blank or block.settings.facebook != blank %}
                            {% assign has_social = true %}
                        {% endif %}

                        {% if has_social %}
                            <div class="tmi-social">
                                <span class="tmi-social-label">{{ block.settings.social_label | default: 'Connect on :' }}</span>
                                <ul class="tmi-social-list">
                                    {% if block.settings.linkedin != blank %}
                                        <li><a href="{{ block.settings.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
                                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.6 8.65 21 11.2 21 14.3V21h-4v-5.9c0-1.4-.03-3.2-1.95-3.2-1.95 0-2.25 1.5-2.25 3.1V21H9z"/></svg>
                                        </a></li>
                                    {% endif %}
                                    {% if block.settings.instagram != blank %}
                                        <li><a href="{{ block.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
                                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.85.07 1.17.05 1.8.25 2.23.42.56.22.96.48 1.38.9.42.42.68.82.9 1.38.17.42.37 1.06.42 2.23.06 1.25.07 1.65.07 4.85s0 3.6-.07 4.85c-.05 1.17-.25 1.8-.42 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.17-1.06.37-2.23.42-1.25.06-1.65.07-4.85.07s-3.6 0-4.85-.07c-1.17-.05-1.8-.25-2.23-.42a3.8 3.8 0 0 1-1.38-.9 3.8 3.8 0 0 1-.9-1.38c-.17-.42-.37-1.06-.42-2.23C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.85c.05-1.17.25-1.8.42-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.17 1.06-.37 2.23-.42C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.14 0-3.5 0-4.74.07-.9.04-1.38.19-1.7.32-.43.16-.74.36-1.06.68-.32.32-.52.63-.68 1.06-.13.32-.28.8-.32 1.7C3.43 8.5 3.42 8.86 3.42 12s0 3.5.07 4.74c.04.9.19 1.38.32 1.7.16.43.36.74.68 1.06.32.32.63.52 1.06.68.32.13.8.28 1.7.32 1.24.06 1.6.07 4.74.07s3.5 0 4.74-.07c.9-.04 1.38-.19 1.7-.32.43-.16.74-.36 1.06-.68.32-.32.52-.63.68-1.06.13-.32.28-.8.32-1.7.06-1.24.07-1.6.07-4.74s0-3.5-.07-4.74c-.04-.9-.19-1.38-.32-1.7a2.86 2.86 0 0 0-.68-1.06 2.86 2.86 0 0 0-1.06-.68c-.32-.13-.8-.28-1.7-.32C15.5 4 15.14 4 12 4zm0 3.06A4.94 4.94 0 1 0 12 17a4.94 4.94 0 0 0 0-9.88zm0 8.15A3.2 3.2 0 1 1 12 8.8a3.2 3.2 0 0 1 0 6.41zm6.3-8.35a1.15 1.15 0 1 1-2.3 0 1.15 1.15 0 0 1 2.3 0z"/></svg>
                                        </a></li>
                                    {% endif %}
                                    {% if block.settings.facebook != blank %}
                                        <li><a href="{{ block.settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
                                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
                                        </a></li>
                                    {% endif %}
                                </ul>
                            </div>
                        {% endif %}
                    </div>

                </div>
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Team Main",
  "blocks": [
    {
      "type": "member",
      "name": "Team Member",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "designation", "label": "Designation" },
        { "type": "richtext", "id": "details", "label": "Details" },
        { "type": "header", "content": "Social" },
        { "type": "text", "id": "social_label", "label": "Social label", "default": "Connect on :" },
        { "type": "url", "id": "linkedin", "label": "LinkedIn URL" },
        { "type": "url", "id": "instagram", "label": "Instagram URL" },
        { "type": "url", "id": "facebook", "label": "Facebook URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team Main",
      "blocks": [
        { "type": "member" },
        { "type": "member" }
      ]
    }
  ]
}
{% endschema %}
