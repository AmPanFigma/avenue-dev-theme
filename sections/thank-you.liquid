<section class="clinical-banner"{% if section.settings.bg_color != blank %} style="background-color: {{ section.settings.bg_color }};"{% endif %}>
    <div class="cb-background">
        <img src="{{ section.settings.background_image | image_url }}" alt="banner background image">
    </div>
    <div class="cb-in">
        <div class="container-fluid">
            <div class="cb-data">
                <h1>{{ section.settings.heading }}</h1>
                <div class="cbdata-bottom">
                    <p>{{ section.settings.highlight }}</p>
                    <div class="heading-btn">
                        <a href="{{ section.settings.button_link | default: '#' }}" class="custom-btn filled">
                            {{ section.settings.button_text }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


{% schema %}
{
  "name": "Thank You",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "highlight",
      "label": "Highlight Text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    { "name": "Thank You" }
  ]
}
{% endschema %}
