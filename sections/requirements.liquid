<section class="requirements">
    <div class="container">
        <div class="requirements-in">
            <div class="ri-left">
                <img src="{{ section.settings.ri-image | image_url }}" alt="{{ section.settings.ri-alt }}">
            </div>
            <div class="ri-right">
                <div class="heading">
                    <div class="subheading">
                        <p>{{ section.settings.highlight }}</p>
                    </div>
                    <h2>{{ section.settings.heading }}</h2>
                    <p>{{ section.settings.para }}</p>
                </div>
            </div>
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Requirement",
  "settings": [
    {
      "type": "image_picker",
      "id": "ri-image",
      "label": "Select Image"
    },
    {
      "type": "text",
      "id": "ri-alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Highlight Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading"
    },
    {
      "type": "text",
      "id": "para",
      "label": "Section Paragraph"
    }
  ],
  "presets": [
    { "name": "Requirement" }
  ]
}
{% endschema %}
