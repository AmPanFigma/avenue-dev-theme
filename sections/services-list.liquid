<section class="services-list" id="ServicesList-{{ section.id }}">
    <div class="container">
        <div class="sl-in">

            <div class="sl-left">
                <div class="heading">
                    {% if section.settings.highlight != blank %}
                        <div class="subheading">
                            <p>{{ section.settings.highlight }}</p>
                        </div>
                    {% endif %}
                    {% if section.settings.heading != blank %}
                        <h2>{{ section.settings.heading }}</h2>
                    {% endif %}
                </div>
                {% if section.settings.footer_text != blank %}
                    <div class="sl-foot">{{ section.settings.footer_text }}</div>
                {% endif %}
            </div>

            <div class="sl-right">
                <div class="sl-pills">
                    {% for block in section.blocks %}
                        {% if block.settings.link != blank %}
                            <a href="{{ block.settings.link }}" class="service-pill" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
                        {% else %}
                            <span class="service-pill" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>
</section>

<script>
  (function () {
    if (typeof gsap === 'undefined') return;
    if (typeof ScrollTrigger !== 'undefined' && gsap.registerPlugin) gsap.registerPlugin(ScrollTrigger);

    var section = document.getElementById('ServicesList-{{ section.id }}');
    if (!section) return;
    var pills = section.querySelectorAll('.service-pill');
    if (!pills.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      gsap.set(pills, { opacity: 1, y: 0 });
      return;
    }

    gsap.set(pills, { opacity: 0, y: 24 });
    gsap.to(pills, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: 'power2.out',
      stagger: 0.08,
      scrollTrigger: { trigger: section, start: 'top 75%', once: true }
    });
  })();
</script>

{% schema %}
{
  "name": "Services List",
  "settings": [
    { "type": "text", "id": "highlight", "label": "Highlight Text", "default": "Services" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore our Services" },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "<p>Don't see what you're looking for here? Get in touch with us here.</p>"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "label", "label": "Service name" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services List",
      "blocks": [
        { "type": "service", "settings": { "label": "Lasers" } },
        { "type": "service", "settings": { "label": "PRP Injections" } },
        { "type": "service", "settings": { "label": "Micro Needling" } },
        { "type": "service", "settings": { "label": "Injectables" } },
        { "type": "service", "settings": { "label": "Laser Hair Removal" } },
        { "type": "service", "settings": { "label": "Botox" } },
        { "type": "service", "settings": { "label": "Dermal Fillers" } },
        { "type": "service", "settings": { "label": "Derma Planning" } },
        { "type": "service", "settings": { "label": "Medical Facial" } }
      ]
    }
  ]
}
{% endschema %}
