{%- assign blog = blogs[section.settings.blog] | default: blog -%}

{%- comment -%} Featured = most recent article with the featured tag, else the newest {%- endcomment -%}
{%- assign featured_tag = section.settings.featured_tag | default: 'featured' -%}
{%- for a in blog.articles -%}
  {%- if a.tags contains featured_tag -%}
    {%- assign featured = a -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- unless featured -%}{%- assign featured = blog.articles.first -%}{%- endunless -%}

<section class="blog-main" id="Blog-{{ section.id }}">
  {%- if featured and section.settings.show_featured -%}
    <div class="blog-featured">
      <div class="bf-content">
        <p class="bf-label">{{ section.settings.featured_label | default: 'Featured' }}</p>
        <h1 class="bf-title">
          <a href="{{ featured.url }}">{{ featured.title }}</a>
        </h1>
        <p class="bf-excerpt">{{ featured.excerpt_or_content | strip_html | truncatewords: 32 }}</p>
        <a href="{{ featured.url }}" class="bf-more link-btn">Read More <span>&rarr;</span></a>
      </div>
      <a href="{{ featured.url }}" class="bf-image">
          {% if featured.image %}
            <img src="{{ featured.image | image_url: width: 1400 }}" alt="{{ featured.title | escape }}">
          {% endif %}
        </a>
    </div>
  {%- endif -%}

  <div class="container-fluid">
    <div class="blog-toolbar">
      <div class="blog-filters">
        <ul class="blog-filter-list">
          <li class="blog-filter active" data-filter="all" role="button" tabindex="0">
            {{ section.settings.all_label | default: 'All' }}
          </li>
          {%- for tag in blog.all_tags -%}
            <li class="blog-filter" data-filter="{{ tag | handle }}" role="button" tabindex="0">{{ tag }}</li>
          {%- endfor -%}
        </ul>
      </div>
      <div class="blog-sort">
        <label class="blog-sort-label" for="BlogSort-{{ section.id }}">Sort by</label>
        <select id="BlogSort-{{ section.id }}" class="blog-sort-select" data-blog-sort>
          <option value="latest">Latest</option>
          <option value="oldest">Oldest</option>
          <option value="az">A - Z</option>
          <option value="za">Z - A</option>
        </select>
      </div>
    </div>

    {% paginate blog.articles by section.settings.per_page %}
      <div class="blog-grid" data-blog-grid>
        {%- for article in blog.articles -%}
          {%- if section.settings.hide_featured_in_grid and article.id == featured.id -%}{%- continue -%}{%- endif -%}
          {% render 'article-card', article: article %}
        {%- else -%}
          <p class="blog-empty">No posts yet.</p>
        {%- endfor -%}
      </div>

      <div class="blogs-empty">
        <p class="blog-none" data-blog-none hidden>{{ section.settings.empty_text | default: 'No blog posts in this category.' }}</p>
      </div>

      {% if paginate.next %}
        <div class="blog-more" data-blog-more data-next-url="{{ paginate.next.url }}">
          <a href="{{ paginate.next.url }}" class="blog-more__link custom-btn grey" rel="next">Load More</a>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>


<script>
  (function () {
    var root = document.getElementById('Blog-{{ section.id }}');
    if (!root) return;
    var grid = root.querySelector('[data-blog-grid]');
    var filters = root.querySelectorAll('.blog-filter');
    var sortSel = root.querySelector('[data-blog-sort]');
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.blog-card'));

    var filterValue = 'all';
    var sortValue = 'latest';

    var noneEl = root.querySelector('[data-blog-none]');
    function applyFilter() {
      var visible = 0;
      cards.forEach(function (card) {
        var tags = (card.getAttribute('data-tags') || '').split(',');
        var show = filterValue === 'all' || tags.indexOf(filterValue) !== -1;
        card.classList.toggle('is-hidden', !show);
        if (show) visible++;
      });
      if (noneEl) noneEl.hidden = visible !== 0;
    }

    function applySort() {
      var sorted = cards.slice().sort(function (a, b) {
        if (sortValue === 'latest') return b.getAttribute('data-date') - a.getAttribute('data-date');
        if (sortValue === 'oldest') return a.getAttribute('data-date') - b.getAttribute('data-date');
        if (sortValue === 'az') return a.getAttribute('data-title').localeCompare(b.getAttribute('data-title'));
        if (sortValue === 'za') return b.getAttribute('data-title').localeCompare(a.getAttribute('data-title'));
        return 0;
      });
      sorted.forEach(function (c) {
        grid.appendChild(c);
      });
    }

    filters.forEach(function (f) {
      function activate() {
        filters.forEach(function (x) {
          x.classList.remove('active');
        });
        f.classList.add('active');
        filterValue = f.getAttribute('data-filter');
        applyFilter();
      }
      f.addEventListener('click', activate);
      f.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activate();
        }
      });
    });

    if (sortSel)
      sortSel.addEventListener('change', function () {
        sortValue = sortSel.value;
        applySort();
      });

    /* ---- Load more ---- */
    var loading = false;
    root.addEventListener('click', function (e) {
      var link = e.target.closest('.blog-more__link');
      if (!link) return;
      e.preventDefault();
      var wrap = root.querySelector('[data-blog-more]');
      if (!wrap || loading) return;
      var url = wrap.getAttribute('data-next-url');
      if (!url) return;
      loading = true;
      link.classList.add('is-loading');
      fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (r) {
          return r.text();
        })
        .then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          doc.querySelectorAll('[data-blog-grid] .blog-card').forEach(function (node) {
            grid.appendChild(node);
            cards.push(node);
          });
          var nextMore = doc.querySelector('[data-blog-more]');
          if (nextMore) {
            wrap.setAttribute('data-next-url', nextMore.getAttribute('data-next-url'));
          } else {
            wrap.remove();
          }
          applyFilter();
          applySort();
          loading = false;
          link.classList.remove('is-loading');
        })
        .catch(function () {
          loading = false;
          link.classList.remove('is-loading');
        });
    });
  })();
</script>

{% schema %}
{
  "name": "Blog Main",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "header", "content": "Featured post" },
    { "type": "checkbox", "id": "show_featured", "label": "Show featured post", "default": true },
    { "type": "text", "id": "featured_label", "label": "Featured label", "default": "Featured" },
    {
      "type": "text",
      "id": "featured_tag",
      "label": "Featured tag",
      "default": "featured",
      "info": "The most recent article with this tag is shown at the top. Leave blank / untagged to use the newest post."
    },
    {
      "type": "checkbox",
      "id": "hide_featured_in_grid",
      "label": "Hide the featured post from the grid below",
      "default": false
    },
    { "type": "header", "content": "Grid" },
    {
      "type": "range",
      "id": "per_page",
      "label": "Posts per page (Load More)",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 8
    },
    { "type": "text", "id": "all_label", "label": "\"All\" filter label", "default": "All" },
    { "type": "text", "id": "empty_text", "label": "Empty category message", "default": "No blog posts in this category." }
  ],
  "presets": [{ "name": "Blog Main" }]
}
{% endschema %}
