<div class="collection-banner">
    <div class="cb-image">
        <img src="{{ section.settings.cb_image | image_url: width: 2000 }}" alt="{{ section.settings.cb_alt }}">
    </div>
</div>

<div class="collection-wrap">
    <div class="container-fluid">
        <div class="cwarp-in">
            <div class="cwarp-head">
                <div class="cwh-left">
                    {% if collection.handle == 'all' %}
                        <h1>All {{ collection.title }}</h1>
                    {% else %}
                        <h1>{{ collection.title }}</h1>
                    {% endif %}
                </div>
                <div class="cwh-center">
                    <div class="collection-filters">
                        <ul>
                            <li>moisturizers <span>22</span></li>
                            <li>cleansers <span>22</span></li>
                            <li>serums <span>22</span></li>
                            <li>masks <span>22</span></li>
                        </ul>
                    </div>
                </div>
                <div class="cwh-right">
                    <div class="collection-sort">

                    </div>
                </div>
            </div>
            <div class="cwarp-product-wrap">
                {% for product in collection.products %}
                    {% render 'product-card', product: product %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "Collection",
    "tag": "section",
    "class": "collectionMain",
    "settings": [
        {
            "type": "image_picker",
            "id": "cb_image",
            "label": "Banner Image"
        },
        {
            "type": "text",
            "id": "cb_alt",
            "label": "Banner Image Alt Text",
            "default": "Collection Banner"
        }
    ],
}
{% endschema %}