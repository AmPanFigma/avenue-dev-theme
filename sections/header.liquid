{% assign filled_pages = 'medical-services,asthetic-services,clinical-trials,about-us,faqs,contact-us,book-an-appointment' | split: ',' %}

{% if template.name == 'collection'
   or template.name == 'product'
   or template.name == '404'
   or filled_pages contains page.handle %}
  <header class="filled" data-ajax-cart-section>
{% else %}
  <header class="transparent" data-ajax-cart-section>
{% endif %}

   <div class="container-fluid">
      <div class="header-in">
         <div class="hi-left">
            <button type="button" class="open menu-trigger" aria-label="Open menu">MENU</button>
            {% assign left_menu = linklists[section.settings.left_menu] %}
            <ul class="header-menu left-menu">
              {% for link in left_menu.links %}
                <li>
                  <a href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
         </div>
         <div class="header-logo">
            <a href="{{ routes.root_url }}">
              {% if section.settings.select_logo %}
                <img
                  src="{{ section.settings.select_logo | image_url }}"
                  alt="{{ shop.name | escape }}"
                  class="icon">
              {% else %}
                {{ shop.name }}
              {% endif %}
            </a>
         </div>
         <div class="hi-right">
            <div class="right-menu">

              {% assign right_menu = linklists[section.settings.right_menu] %}
              {% assign shop_menu = linklists[section.settings.shop_mega_menu] %}
              {% assign about_menu = linklists[section.settings.about_mega_menu] %}

              <ul class="header-menu">

                {% for link in right_menu.links %}
                  {% comment %} Logic for adding mega menu class on items which have mega menu {% endcomment %}
                  {% assign has_mega = false %}
                  {% if link.title == 'Shop' and shop_menu.links.size > 0 %}
                    {% assign has_mega = true %}
                  {% endif %}
                  {% if link.title == 'About' and about_menu.links.size > 0 %}
                    {% assign has_mega = true %}
                  {% endif %}
                  {% comment %} Logic for adding mega menu class on items which have mega menu {% endcomment %}

                  <li class="menu-item {% if has_mega %}has-mega-menu{% endif %}">

                    <a href="{{ link.url }}">
                      {{ link.title }}
                    </a>

                    {% if link.handle == 'shop' and shop_menu.links.size > 0 %}
                      <div class="mega-menu">
                        <div class="megamenu-in">
                            <!-- First Column -->
                            <div class="mega-column">
                                {% for parent in shop_menu.links %}
                                    {% if parent.links.size == 0 %}
                                        <a href="{{ parent.url }}" class="mega-heading-link">
                                            <p class="mega-title">{{ parent.title }}</p>
                                        </a>
                                    {% endif %}
                                {% endfor %}
                            </div>

                            <!-- Remaining Columns -->
                            {% for parent in shop_menu.links %}
                                {% if parent.links.size > 0 %}
                                    <div class="mega-column">
                                        <p class="mega-title">{{ parent.title }}</p>
                                        <ul>
                                          {% for child in parent.links %}
                                            <li>
                                                <a href="{{ child.url }}">{{ child.title }}</a>
                                            </li>
                                          {% endfor %}
                                        </ul>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                      </div>
                    {% endif %}

                    {% if link.title == 'About' and about_menu.links.size > 0 %}
                      <div class="mega-menu small">
                        <div class="megamenu-in">
                          <div class="mega-column">
                            <ul>
                              {% for item in about_menu.links %}
                                <li>
                                  <a href="{{ item.url }}">
                                    {{ item.title }}
                                  </a>
                                </li>
                              {% endfor %}
                            </ul>
                          </div>
                        </div>
                      </div>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
            <div class="right-extra">
               {% if customer %}
                    <a href="{{ routes.account_url }}" class="cust-login account-link">
                        <span class="account-text">Account</span>
                        {% render 'icon-account' %}
                    </a>
                {% else %}
                    <a href="{{ routes.account_login_url }}" class="profile account-link">
                        <span class="account-text">Login</span>
                        {% render 'icon-account' %}
                    </a>
                {% endif %}
                {% unless template.name == 'cart' %}
                <div class="cart" data-ajax-cart-section>
                    <a href="javascript:void(0)" class="cart-open">
                        <span class="cart-text">Cart</span>
                         {% render 'cart-icon' %}
                        (<span data-ajax-cart-bind="item_count" class="header__cart-quantity">{{ cart.item_count }}</span>)
                    </a>
                </div>
                {% endunless %}
            </div>
         </div>
      </div>
      <div class="h-nav" id="mySidenav">
          <div class="hnav-menu">

            <div class="hnav-top">
              <button type="button" class="close" aria-label="Close menu">CLOSE X</button>
            </div>

            <ul class="mob-menu">

              {% comment %} Left menu — simple links ('---' = spacer) {% endcomment %}
              {% for link in left_menu.links %}
                {% if link.title == '---' %}
                  <li class="mob-spacer" aria-hidden="true"></li>
                {% else %}
                  <li class="mob-item"><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endif %}
              {% endfor %}

              {% comment %} Right menu — Shop / About expand into sub-panels {% endcomment %}
              {% for link in right_menu.links %}

                {% if link.title == '---' %}
                  <li class="mob-spacer" aria-hidden="true"></li>

                {% elsif link.title == 'Shop' and shop_menu.links.size > 0 %}
                  <li class="mob-link">
                    <a href="{{ link.url }}" class="mob-link_inner">{{ link.title }} <span class="caret">&rsaquo;</span></a>
                    <div class="sublinks_wrapper">
                      <div class="hnav-top">
                        <button type="button" class="nav_back_link" aria-label="Back">&lsaquo; BACK</button>
                        <button type="button" class="close" aria-label="Close menu">CLOSE X</button>
                      </div>
                      <div class="hnav-bottom">
                        <p class="subnav-title">{{ link.title }}</p>
                        <ul class="subnav-list">
                            {% comment %} Direct links (no children) e.g. Shop All, Best Sellers {% endcomment %}
                            {% for parent in shop_menu.links %}
                            {% if parent.links.size == 0 %}
                                <li><a href="{{ parent.url }}">{{ parent.title }}</a></li>
                            {% endif %}
                            {% endfor %}
                            {% comment %} Expandable groups e.g. By Concern, By Product {% endcomment %}
                            {% for parent in shop_menu.links %}
                            {% if parent.links.size > 0 %}
                                <li class="mob-sublink">
                                <a href="{{ parent.url }}" class="mob-sublink_inner">{{ parent.title }} <span class="caret">&rsaquo;</span></a>
                                <div class="childlink_wrapper">
                                    <div class="hnav-top">
                                        <button type="button" class="nav_back_sublink" aria-label="Back">&lsaquo; BACK</button>
                                        <button type="button" class="close" aria-label="Close menu">CLOSE X</button>
                                    </div>
                                    <div class="hnav-bottom">
                                        <p class="subnav-title">{{ parent.title }}</p>
                                        <ul class="subnav-list">
                                        {% for child in parent.links %}
                                            <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                                        {% endfor %}
                                        </ul>
                                    </div>
                                    {% render 'header-menu-promo', blocks: section.blocks, panel: parent.title %}
                                </div>
                                </li>
                            {% endif %}
                            {% endfor %}
                        </ul>
                      </div>
                      {% render 'header-menu-promo', blocks: section.blocks, panel: link.title %}
                    </div>
                  </li>

                {% elsif link.title == 'About' and about_menu.links.size > 0 %}
                  <li class="mob-link">
                    <a href="{{ link.url }}" class="mob-link_inner">{{ link.title }} <span class="caret">&rsaquo;</span></a>
                    <div class="sublinks_wrapper">
                      <div class="hnav-top">
                        <button type="button" class="nav_back_link" aria-label="Back">&lsaquo; BACK</button>
                        <button type="button" class="close" aria-label="Close menu">CLOSE X</button>
                      </div>
                      <div class="hnav-bottom">
                        <p class="subnav-title">{{ link.title }}</p>
                        <ul class="subnav-list">
                            {% for item in about_menu.links %}
                            <li><a href="{{ item.url }}">{{ item.title }}</a></li>
                            {% endfor %}
                        </ul>
                      </div>
                      {% render 'header-menu-promo', blocks: section.blocks, panel: link.title %}
                    </div>
                  </li>

                {% else %}
                  <li class="mob-item"><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endif %}

              {% endfor %}
            </ul>

            {% if section.settings.schedule_link != blank %}
              <div class="hnav-foot">
                <a href="{{ section.settings.schedule_link }}" class="custom-btn grey">{{ section.settings.schedule_label | default: 'Schedule Visit' }}</a>
              </div>
            {% endif %}

          </div>
      </div>
   </div>
</header>

{% schema %}
  {
    "name": "Header",
    "settings": [
      {
        "type": "image_picker",
        "id": "select_logo",
        "label": "Change Logo"
      },
      {
        "type": "link_list",
        "id": "left_menu",
        "label": "Left Menu"
      },
      {
        "type": "link_list",
        "id": "right_menu",
        "label": "Right Menu"
      },
      {
        "type": "link_list",
        "id": "shop_mega_menu",
        "label": "Shop Mega Menu"
      },
      {
        "type": "link_list",
        "id": "about_mega_menu",
        "label": "About Mega Menu"
      },
      {
        "type": "header",
        "content": "Mobile menu"
      },
      {
        "type": "url",
        "id": "schedule_link",
        "label": "Schedule button link"
      },
      {
        "type": "text",
        "id": "schedule_label",
        "label": "Schedule button label",
        "default": "Schedule Visit"
      }
    ],
    "blocks": [
      {
        "type": "promo",
        "name": "Mobile menu promo",
        "settings": [
          {
            "type": "paragraph",
            "content": "Shows at the bottom of a mobile sub-panel. 'Panel name' must exactly match the menu item title (e.g. Shop, About, By Concern)."
          },
          { "type": "text", "id": "panel", "label": "Panel name" },
          { "type": "text", "id": "heading", "label": "Heading", "default": "Discover Bundles" },
          { "type": "product", "id": "product", "label": "Product (optional)", "info": "If set, shows the product image. Falls back to the image below." },
          { "type": "image_picker", "id": "image", "label": "Image (fallback)" },
          { "type": "url", "id": "link", "label": "Image / product link" },
          { "type": "text", "id": "button_label", "label": "Button label" },
          { "type": "url", "id": "button_link", "label": "Button link" }
        ]
      }
    ],

    "presets": [
      {
        "name": "Header"
      }
    ]
  }
{% endschema %}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

<script>
  $(function() {
    // mobile drawer toggles (if you use them)
    $('.close').hide();
    $('.open').on('click', function() {
      $('.h-nav').addClass('active');
      $('body').attr('data-lenis-prevent', 'true'); // add attribute
      $('.close').show();
      $('.open').hide();
    });
    $('.close').on('click', function() {
      $('.h-nav').removeClass('active');
      $('body').removeAttr('data-lenis-prevent'); // remove attribute
      $('.close').hide();
      $('.open').show();
      // reset any open sub-panels so reopening starts at the top level
      $('.sublinks_wrapper, .childlink_wrapper').removeClass('visible');
    });

    // nested mobile subnav
    $('.mob-link_inner').on('click', function(e) {
      e.preventDefault();
      $(this).closest('.mob-link').find('.sublinks_wrapper').addClass('visible');
    });
    $('.mob-sublink_inner').on('click', function(e) {
      e.preventDefault();
      $(this).closest('.mob-sublink').find('.childlink_wrapper').addClass('visible');
    });
    $('.nav_back_link').on('click', function(e) {
      e.preventDefault();
      $(this).closest('.sublinks_wrapper').removeClass('visible');
    });
    $('.nav_back_sublink').on('click', function(e) {
      e.preventDefault();
      $(this).closest('.childlink_wrapper').removeClass('visible');
    });

    // backdrop hover for desktop mega menu
    $('.nav-item.has-mega-menu').on('mouseenter', function() {
      $('main').addClass('backdrop_bg');
    }).on('mouseleave', function() {
      $('main').removeClass('backdrop_bg');
    });
  });

</script>
