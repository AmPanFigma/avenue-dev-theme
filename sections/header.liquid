<header class="transparent" data-ajax-cart-section>
   <div class="container-fluid">
      <div class="header-in">
         <div class="hi-left">

         </div>
         <div class="header-logo">
            <a href="{{ routes.root_url }}">
              {% if section.settings.select_logo %}
                <img
                  src="{{ section.settings.select_logo | image_url }}"
                  alt="{{ shop.name | escape }}"
                  class="icon">
              {% else %}
                {{ shop.name }}
              {% endif %}
            </a>
         </div>
         <div class="hi-right">
            <div class="right-menu"></div>
            <div class="right-extra">
               {% if customer %}
                  <a href="{{ routes.account_url }}" class="cust-login">Account</a>
               {% else %}
                  <a href="{{ routes.account_login_url }}" class="profile">login</a>
               {% endif %}
               {% unless template.name == 'cart' %}
               <div class="cart" data-ajax-cart-section>
                  <a href="javascript:void(0)" class="cart-open">
                     Cart <span data-ajax-cart-bind="item_count" class="header__cart-quantity">{{ cart.item_count }}</span>
                  </a>
               </div>
               {% endunless %}
            </div>
         </div>
      </div>
   </div>
</header>

{% schema %}
  {
    "name": "Header",
    "settings": [
      {
        "type": "image_picker",
        "id": "select_logo",
        "label": "Change Logo"
      }
    ],
    "blocks": [
      {
        "type": "nav_menu_right",
        "name": "Nav Menu Right",
        "settings": [
          {
            "type": "link_list",
            "id": "nav_items_right",
            "label": "Nav Items"
          },
          {
            "type": "text",
            "id": "product_list_heading",
            "label": "Product List Heading"
          },
          {
            "type": "product_list",
            "id": "product_list",
            "label": "Select Products",
            "limit": 3
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Header"
      }
    ]
  }
{% endschema %}
