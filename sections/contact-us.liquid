<section class="contact-page enquiry-page">
  <div class="ep-grid">

    <div class="ep-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}">
      {% endif %}
    </div>

    <div class="ep-content">
      <div class="ep-content-in">
        {% if section.settings.heading != blank %}
          <h1 class="ep-title">{{ section.settings.heading }}</h1>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="ep-desc">{{ section.settings.description }}</div>
        {% endif %}

        {% if section.settings.email != blank %}
          <div class="ep-info">
            <p class="ep-info-label">Email</p>
            <a class="ep-info-value" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </div>
        {% endif %}

        {% assign has_social = false %}
        {% if section.settings.linkedin != blank or section.settings.instagram != blank or section.settings.facebook != blank %}
          {% assign has_social = true %}
        {% endif %}
        {% if has_social %}
          <div class="ep-info ep-social">
            <p class="ep-info-label">Social</p>
            <ul class="ep-social-list">
              {% if section.settings.linkedin != blank %}<li><a href="{{ section.settings.linkedin }}" target="_blank" rel="noopener">LinkedIn</a></li>{% endif %}
              {% if section.settings.instagram != blank %}<li><a href="{{ section.settings.instagram }}" target="_blank" rel="noopener">Instagram</a></li>{% endif %}
              {% if section.settings.facebook != blank %}<li><a href="{{ section.settings.facebook }}" target="_blank" rel="noopener">Facebook</a></li>{% endif %}
            </ul>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ep-form">
      <div class="ep-form-in">
        {% render 'enquiry-form',
          heading: section.settings.form_heading,
          consent_text: section.settings.consent_text,
          submit_label: section.settings.submit_label,
          success_text: section.settings.success_text,
          thankyou_url: section.settings.thankyou_url %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Contact Us",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Left image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in Touch" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Pellentesque bibendum dolor tortor diam. Cursus in metus egestas sollicitudin.</p>" },
    { "type": "header", "content": "Contact info" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@avenuedermatologygroup.com" },
    { "type": "text", "id": "linkedin", "label": "LinkedIn URL" },
    { "type": "text", "id": "instagram", "label": "Instagram URL" },
    { "type": "text", "id": "facebook", "label": "Facebook URL" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Fill The Form For Aesthetic Enquiries" },
    { "type": "text", "id": "submit_label", "label": "Submit label", "default": "Submit" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks — we will be in touch." },
    { "type": "url", "id": "thankyou_url", "label": "Redirect to page on success" },
    { "type": "textarea", "id": "consent_text", "label": "Consent checkbox", "default": "I consent to being contacted by Avenue Dermatology Group for clinical trial screenings. By providing my contact information, I agree to receive further information about appointment availability and scheduling." }
  ]
}
{% endschema %}
