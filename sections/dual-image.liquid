<section class="dual-image">
    <div class="container-fluid">
        <div class="dualimage-in">
            <div class="dii-image">
                <img src="{{ section.settings.dii_image | image_url }}" alt="banner image">
            </div>
            <div class="dii-image">
                <img src="{{ section.settings.dii_background | image_url }}" alt="banner image">
                <div class="dii-text">
                    <div class="empty"></div>
                    <div class="diitext-top">
                        <h2>{{ section.settings.heading }}</h2>
                    </div>
                    <div class="diitext-bottom">
                        <p>{{ section.settings.paragraph }}</p>
                        <a href="{{ section.settings.button_link | default: '#' }}" class="custom-btn filled">{{ section.settings.button_text }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Dual Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "dii_image",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "dii_background",
      "label": "Image 2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "paragraph",
      "label": "Paragraph"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    { "name": "Dual Image" }
  ]
}
{% endschema %}