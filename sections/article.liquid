{%- assign share_url = shop.url | append: article.url -%}

<section class="article-main" id="Article-{{ section.id }}">

  {%- comment -%} Hero {%- endcomment -%}
  <div class="article-hero">
    <div class="ah-content">
      {%- assign hero_label = article.tags | first -%}
      {%- if hero_label != blank -%}<p class="ah-label">{{ hero_label }}</p>{%- endif -%}
      <h1 class="ah-title">{{ article.title }}</h1>
      {%- if article.excerpt != blank -%}
        <div class="ah-excerpt">{{ article.excerpt }}</div>
      {%- else -%}
        <p class="ah-excerpt">{{ article.content | strip_html | truncatewords: 32 }}</p>
      {%- endif -%}
      <a href="#ArticleBody-{{ section.id }}" class="ah-more link-btn">Read More <span>&rarr;</span></a>
    </div>
    <div class="ah-image">
      {% if article.image %}
        <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.title | escape }}">
      {% endif %}
    </div>
  </div>

  {%- comment -%} Body {%- endcomment -%}
  <div class="container">
    <div class="article-body" id="ArticleBody-{{ section.id }}">
      <div class="rte">{{ article.content }}</div>

      <div class="article-share">
        <span class="article-share__label">Share</span>
        <ul class="article-share__list">
          <li>
            <button type="button" class="article-share__native" aria-label="Share" data-share-url="{{ share_url }}" data-share-title="{{ article.title | escape }}">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
            </button>
          </li>
          <li>
            <a href="https://www.facebook.com/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Facebook">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
            </a>
          </li>
          <li>
            <a href="https://wa.me/?text={{ article.title | append: ' ' | append: share_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.11.82.83-3.03-.2-.31a8.16 8.16 0 0 1-1.25-4.36c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.23 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29z"/></svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  {%- comment -%} Suggested reading {%- endcomment -%}
  {%- assign related_count = 0 -%}
  {%- assign has_related = false -%}
  {%- for a in blog.articles -%}
    {%- if a.id != article.id -%}{%- assign has_related = true -%}{%- break -%}{%- endif -%}
  {%- endfor -%}

  {%- if has_related -%}
    <div class="container-fluid">
      <div class="article-related">
        <div class="heading">
          <div class="subheading"><p>{{ section.settings.related_highlight | default: 'Suggested Reading' }}</p></div>
          <h2>{{ section.settings.related_heading | default: 'You might also like' }}</h2>
        </div>
        <div class="article-related-grid">
          {%- for a in blog.articles -%}
            {%- if a.id == article.id -%}{%- continue -%}{%- endif -%}
            {%- assign related_count = related_count | plus: 1 -%}
            {% render 'article-card', article: a %}
            {%- if related_count >= 4 -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

</section>

<style>
  #Article-{{ section.id }} { padding-bottom: 100px; }

  /* Hero */
  #Article-{{ section.id }} .article-hero { display: grid; grid-template-columns: 1fr 1fr; align-items: center; margin-bottom: 90px; }
  #Article-{{ section.id }} .ah-content { padding: 40px 60px; max-width: 520px; margin-left: auto; }
  #Article-{{ section.id }} .ah-label { text-transform: uppercase; letter-spacing: 0.24em; font-size: 12px; font-family: var(--ppneue); margin-bottom: 20px; }
  #Article-{{ section.id }} .ah-title { font-size: clamp(28px, 2.6vw, 40px); line-height: 1.15; margin-bottom: 20px; }
  #Article-{{ section.id }} .ah-excerpt { color: var(--text-tertiary); line-height: 1.7; margin-bottom: 30px; }
  #Article-{{ section.id }} .ah-excerpt p { margin: 0; }
  #Article-{{ section.id }} .ah-image img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Body */
  #Article-{{ section.id }} .article-body { max-width: 760px; margin: 0 auto; }
  #Article-{{ section.id }} .rte { color: var(--text-tertiary); line-height: 1.8; }
  #Article-{{ section.id }} .rte h2, #Article-{{ section.id }} .rte h3 { color: var(--text-primary); margin: 40px 0 16px; }
  #Article-{{ section.id }} .rte p { margin: 0 0 20px; }
  #Article-{{ section.id }} .rte img { width: 100%; height: auto; margin: 30px 0 10px; }
  #Article-{{ section.id }} .rte figcaption { text-align: center; font-size: 13px; color: var(--text-tertiary); margin-bottom: 30px; }

  /* Share */
  #Article-{{ section.id }} .article-share { display: flex; align-items: center; gap: 20px; margin-top: 60px; }
  #Article-{{ section.id }} .article-share__label { text-transform: uppercase; letter-spacing: 0.24em; font-size: 12px; font-family: var(--ppneue); }
  #Article-{{ section.id }} .article-share__list { display: flex; align-items: center; gap: 16px; list-style: none; margin: 0; padding: 0; }
  #Article-{{ section.id }} .article-share__list a,
  #Article-{{ section.id }} .article-share__native { color: var(--text-primary); background: none; border: 0; padding: 0; cursor: pointer; display: inline-flex; }

  /* Related */
  #Article-{{ section.id }} .article-related { margin-top: 120px; }
  #Article-{{ section.id }} .article-related .heading { margin-bottom: 40px; }
  #Article-{{ section.id }} .article-related-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px 30px; }
  #Article-{{ section.id }} .blog-card__media { display: block; background: var(--bg-light); aspect-ratio: 3 / 4; overflow: hidden; }
  #Article-{{ section.id }} .blog-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #Article-{{ section.id }} .blog-card__body { padding-top: 18px; }
  #Article-{{ section.id }} .blog-card__cat { text-transform: uppercase; letter-spacing: 0.2em; font-size: 11px; color: var(--text-tertiary); margin: 0 0 8px; font-family: var(--ppneue); }
  #Article-{{ section.id }} .blog-card__title { font-size: 16px; line-height: 1.35; font-weight: 400; }
  #Article-{{ section.id }} .blog-card__title a { color: var(--text-primary); text-decoration: none; }

  @media (max-width: 991px) {
    #Article-{{ section.id }} .article-hero { grid-template-columns: 1fr; }
    #Article-{{ section.id }} .ah-content { margin: 0; max-width: none; padding: 30px 20px; order: 2; }
    #Article-{{ section.id }} .article-related-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('Article-{{ section.id }}');
    if (!root) return;
    var btn = root.querySelector('.article-share__native');
    if (btn && navigator.share) {
      btn.addEventListener('click', function () {
        navigator.share({ title: btn.getAttribute('data-share-title'), url: btn.getAttribute('data-share-url') }).catch(function () {});
      });
    } else if (btn) {
      btn.addEventListener('click', function () {
        navigator.clipboard && navigator.clipboard.writeText(btn.getAttribute('data-share-url'));
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Article",
  "settings": [
    { "type": "text", "id": "related_highlight", "label": "Related highlight", "default": "Suggested Reading" },
    { "type": "text", "id": "related_heading", "label": "Related heading", "default": "You might also like" }
  ]
}
{% endschema %}
