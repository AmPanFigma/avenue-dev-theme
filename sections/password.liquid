{% comment %}
  Avenue Dermatology Group — Password / Coming Soon Page
{% endcomment %}

<section
  class="adg-coming-soon"
  style="
    --adg-background: {{ section.settings.background_color }};
    --adg-text: {{ section.settings.text_color }};
    --adg-accent: {{ section.settings.accent_color }};
  "
>
  {% if section.settings.decorative_graphic != blank %}
    {{
      section.settings.decorative_graphic
      | image_url: width: 1800
      | image_tag: class: 'adg-coming-soon__graphic', loading: 'eager', alt: ''
    }}
  {% endif %}
  <div class="adg-coming-soon__content">
    {% if section.settings.logo != blank %}
      {{
        section.settings.logo
        | image_url: width: 900
        | image_tag:
          class: 'adg-coming-soon__logo',
          widths: '300, 450, 600, 900',
          sizes: '(max-width: 749px) 240px, 360px',
          loading: 'eager',
          alt: shop.name
      }}
    {% else %}
      <p class="adg-coming-soon__brand">
        {{ shop.name }}
      </p>
    {% endif %}

    {% if section.settings.eyebrow != blank %}
      <p class="adg-coming-soon__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    <h1 class="adg-coming-soon__heading">
      {{ section.settings.heading }}
    </h1>

    {% if shop.password_message != blank %}
      <div class="adg-coming-soon__message">
        {{ shop.password_message }}
      </div>
    {% elsif section.settings.message != blank %}
      <div class="adg-coming-soon__message">
        {{ section.settings.message }}
      </div>
    {% endif %}

    {% if section.settings.address != blank %}
      <p class="adg-coming-soon__address">
        {{ section.settings.address }}
      </p>
    {% endif %}
  </div>

  <details class="adg-coming-soon__access">
    <summary>Staff access</summary>

    <div class="adg-coming-soon__access-panel">
      {% form 'storefront_password' %}
        {% if form.errors %}
          <div class="adg-coming-soon__errors">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <label for="password-input-{{ section.id }}"> Password </label>

        <div class="adg-coming-soon__form-row">
          <input
            type="password"
            name="password"
            id="password-input-{{ section.id }}"
            autocomplete="current-password"
            required
          >

          <button type="submit">Enter</button>
        </div>
      {% endform %}
    </div>
  </details>
</section>

<style>
    .adg-coming-soon,
    .adg-coming-soon * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
    }

    .adg-coming-soon {
      position: relative;
      display: flex;
      min-height: 100vh;
      min-height: 100svh;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 64px 24px 96px;
      background: var(--adg-background);
      color: var(--adg-text);
      font-family: Arial, Helvetica, sans-serif;
      text-align: center;
    }

  .adg-coming-soon__graphic {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.35;
    pointer-events: none;
  }

    .adg-coming-soon__content {
      position: relative;
      z-index: 1;
      width: min(100%, 760px);
    }

    .adg-coming-soon__logo {
      display: block;
      width: min(100%, 360px);
      height: auto;
      margin: 0 auto 48px;
    }

    .adg-coming-soon__brand {
      margin: 0 0 48px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(24px, 4vw, 40px);
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .adg-coming-soon__eyebrow {
      margin: 0 0 20px;
      color: var(--adg-accent);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    .adg-coming-soon__heading {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(42px, 7vw, 76px);
      font-weight: 400;
      letter-spacing: -0.035em;
      line-height: 1.05;
    }

    .adg-coming-soon__message {
      max-width: 650px;
      margin: 28px auto 0;
      font-size: clamp(16px, 2vw, 19px);
      line-height: 1.7;
    }

    .adg-coming-soon__message p {
      margin: 0;
    }

    .adg-coming-soon__address {
      margin: 32px 0 0;
      color: var(--adg-accent);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.14em;
      line-height: 1.6;
      text-transform: uppercase;
    }

    .adg-coming-soon__access {
      position: absolute;
      z-index: 2;
      right: 24px;
      bottom: 24px;
      text-align: left;
    }

    .adg-coming-soon__access summary {
      color: var(--adg-text);
      cursor: pointer;
      font-size: 12px;
      letter-spacing: 0.08em;
      list-style: none;
      opacity: 0.65;
      text-transform: uppercase;
    }

    .adg-coming-soon__access summary::-webkit-details-marker {
      display: none;
    }

    .adg-coming-soon__access-panel {
      position: absolute;
      right: 0;
      bottom: 34px;
      width: min(340px, calc(100vw - 48px));
      padding: 22px;
      border: 1px solid rgba(112, 91, 73, 0.2);
      background: var(--adg-background);
      box-shadow: 0 16px 50px rgba(39, 34, 29, 0.12);
    }

    .adg-coming-soon__access label {
      display: block;
      margin-bottom: 10px;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .adg-coming-soon__form-row {
      display: flex;
    }

    .adg-coming-soon__form-row input {
      min-width: 0;
      flex: 1;
      padding: 12px;
      border: 1px solid rgba(112, 91, 73, 0.35);
      border-radius: 0;
      background: transparent;
      color: var(--adg-text);
      font: inherit;
    }

    .adg-coming-soon__form-row button {
      padding: 12px 18px;
      border: 1px solid var(--adg-accent);
      border-radius: 0;
      background: var(--adg-accent);
      color: #ffffff;
      cursor: pointer;
      font: inherit;
    }

    .adg-coming-soon__errors {
      margin-bottom: 14px;
      font-size: 13px;
    }

    @media (max-width: 749px) {
      .adg-coming-soon {
        padding: 48px 22px 110px;
      }

      .adg-coming-soon__logo {
        width: min(100%, 260px);
        margin-bottom: 36px;
      }

      .adg-coming-soon__access {
        right: 50%;
        bottom: 28px;
        transform: translateX(50%);
        white-space: nowrap;
      }

      .adg-coming-soon__access-panel {
        right: 50%;
        transform: translateX(50%);
        white-space: normal;
      }
    }
</style>

{% schema %}
{
  "name": "Coming soon",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "image_picker",
      "id": "decorative_graphic",
      "label": "Decorative line graphic"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Avenue Dermatology Group"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our new website is coming soon"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Fallback message",
      "default": "We are preparing to welcome patients to our new Toronto dermatology clinic. Please check back shortly for updates."
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "491 Eglinton Avenue West, Suite 400, Toronto"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#f4f1ec"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#292521"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#705b49"
    }
  ]
}
{% endschema %}
