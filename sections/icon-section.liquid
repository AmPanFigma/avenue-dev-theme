<section class="icon-section">
    <div class="container">
        {% if section.settings.heading != blank %}
            <div class="heading center">
                <div class="subheading">
                    <p>{{ section.settings.highlight }}</p>
                </div>
                <h2>{{ section.settings.heading }}</h2>
            </div>
        {% endif %}
        <div class="iconsec-in">
            {% for block in section.blocks %}
                <div class="icon-item" {{ block.shopify_attributes }}>
                    <div class="ii-image">
                        {% if block.settings.image != blank %}
                            <img src="{{ block.settings.image | image_url: width: 300 }}"
                                 alt="{{ block.settings.heading | escape }}"
                                 width="{{ block.settings.image.width }}"
                                 height="{{ block.settings.image.height }}"
                                 loading="lazy">
                        {% endif %}
                    </div>
                    <div class="ii-text">
                        {% if block.settings.number != blank %}
                            <div class="iit-num">{{ block.settings.number }}</div>
                        {% endif %}
                        {% if block.settings.heading != blank %}
                            <h3>{{ block.settings.heading }}</h3>
                        {% endif %}
                        {% if block.settings.text != blank %}
                            <p>{{ block.settings.text }}</p>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Icon Section",
  "settings": [
    { 
      "type": "text", 
      "id": "highlight", 
      "label": "Section Highlight Text" 
    },
    { 
      "type": "text", 
      "id": "heading", 
      "label": "Section Heading Text" 
    }
  ],
  "blocks": [
    {
      "type": "icon_item",
      "name": "Icon Item",
      "settings": [
        { 
          "type": "image_picker", 
          "id": "image", 
          "label": "Icon / Image" 
        },
        { 
          "type": "text", 
          "id": "number", 
          "label": "Number" 
        },
        { 
          "type": "text", 
          "id": "heading", 
          "label": "Heading" 
        },
        { 
          "type": "textarea", 
          "id": "text", 
          "label": "Text" 
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon Section",
      "blocks": [
        { "type": "icon_item" },
        { "type": "icon_item" },
        { "type": "icon_item" }
      ]
    }
  ]
}
{% endschema %}
