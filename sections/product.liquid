{% comment %} Product page {% endcomment %}
{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="pdp" id="Pdp-{{ section.id }}" data-product-id="{{ product.id }}">
  <div class="container-fluid">

    <nav class="pdp-breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      {%- if collection -%}
        <span>&bull;</span><a href="{{ collection.url }}">{{ collection.title }}</a>
      {%- endif -%}
      <span>&bull;</span><span class="current">{{ product.title }}</span>
    </nav>

    <div class="pdp-main">

      {%- comment -%} Left: stacked gallery {%- endcomment -%}
      <div class="pdp-gallery">
        {%- for image in product.images -%}
          <div class="pdp-media">
            <img src="{{ image | image_url: width: 1200 }}"
                 alt="{{ image.alt | escape | default: product.title }}"
                 width="{{ image.width }}" height="{{ image.height }}"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          </div>
        {%- else -%}
          <div class="pdp-media">{{ 'product-1' | placeholder_svg_tag }}</div>
        {%- endfor -%}
      </div>

      {%- comment -%} Right: sticky info {%- endcomment -%}
      <div class="pdp-info">
        <div class="pdp-info-in">

          <h1 class="pdp-title">{{ product.title }}</h1>
          <p class="pdp-price" data-pdp-price>{{ current_variant.price | money }}</p>

          {%- if product.description != blank -%}
            <div class="pdp-desc">{{ product.description }}</div>
          {%- endif -%}

          {% form 'product', product, class: 'pdp-form' %}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-pdp-id>

            {%- comment -%} Variant options {%- endcomment -%}
            {%- unless product.has_only_default_variant -%}
              <div class="pdp-variants">
                {%- for option in product.options_with_values -%}
                  <div class="pdp-option">
                    <label class="pdp-option-label">{{ option.name }}</label>
                    <select class="pdp-option-select" data-pdp-option="{{ forloop.index0 }}">
                      {%- for value in option.values -%}
                        <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                      {%- endfor -%}
                    </select>
                  </div>
                {%- endfor -%}
              </div>
              <script type="application/json" data-pdp-variants>{{ product.variants | json }}</script>
            {%- endunless -%}

            {%- comment -%} Delivery method {%- endcomment -%}
            <div class="pdp-delivery">
              <p class="pdp-block-label">How do you want it delivered?</p>

              <label class="pdp-deliv">
                <input type="radio" name="delivery_method" value="pickup" checked data-delivery-pickup>
                <span class="pdp-deliv-body">
                  <span class="pdp-deliv-title">Store Pickup</span>
                  <span class="pdp-deliv-sub">{{ section.settings.pickup_address }}</span>
                </span>
              </label>

              <label class="pdp-deliv">
                <input type="radio" name="delivery_method" value="ship">
                <span class="pdp-deliv-body">
                  <span class="pdp-deliv-title">Ship</span>
                  <span class="pdp-deliv-sub">{{ section.settings.ship_estimate }}</span>
                </span>
              </label>
            </div>

            <div class="pdp-actions">
              <button type="submit" name="add" class="pdp-atc custom-btn black" {% unless current_variant.available %}disabled{% endunless %}>
                <span>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
              </button>
              {{ form | payment_button }}
            </div>
          {% endform %}

          {%- comment -%} Payment icons {%- endcomment -%}
          {%- if shop.enabled_payment_types.size > 0 -%}
            <div class="pdp-payments">
              {%- for type in shop.enabled_payment_types -%}
                {{ type | payment_type_svg_tag: class: 'pdp-pay-icon' }}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- comment -%} Complete your routine (recommendation) {%- endcomment -%}
          <div class="pdp-upsell" data-upsell data-product-id="{{ product.id }}" data-url="{{ routes.product_recommendations_url }}">
            <p class="pdp-block-label">Complete your routine</p>
            <div class="pdp-upsell-slot" data-upsell-slot></div>
          </div>

          {%- comment -%} Accordions {%- endcomment -%}
          <div class="pdp-accordions">
            {%- assign how_to_use = product.metafields.custom.how_to_use -%}
            {%- assign ingredients = product.metafields.custom.ingredients -%}
            {%- assign shipping = product.metafields.custom.shipping_returns -%}

            {%- if product.description != blank -%}
            <div class="pdp-acc active">
              <button type="button" class="pdp-acc-head"><span>Product Details</span><span class="pdp-acc-icon" aria-hidden="true"></span></button>
              <div class="pdp-acc-body"><div class="pdp-acc-in">{{ product.description }}</div></div>
            </div>
            {%- endif -%}

            {%- if how_to_use != blank -%}
              <div class="pdp-acc">
                <button type="button" class="pdp-acc-head"><span>How To Use</span><span class="pdp-acc-icon" aria-hidden="true"></span></button>
                <div class="pdp-acc-body"><div class="pdp-acc-in">{{ how_to_use | metafield_tag }}</div></div>
              </div>
            {%- endif -%}

            {%- if ingredients != blank -%}
              <div class="pdp-acc">
                <button type="button" class="pdp-acc-head"><span>Ingredients</span><span class="pdp-acc-icon" aria-hidden="true"></span></button>
                <div class="pdp-acc-body"><div class="pdp-acc-in">{{ ingredients | metafield_tag }}</div></div>
              </div>
            {%- endif -%}

            {%- if shipping != blank -%}
              <div class="pdp-acc">
                <button type="button" class="pdp-acc-head"><span>Shipping and Returns</span><span class="pdp-acc-icon" aria-hidden="true"></span></button>
                <div class="pdp-acc-body"><div class="pdp-acc-in">{{ shipping | metafield_tag }}</div></div>
              </div>
            {%- elsif section.settings.shipping_default != blank -%}
              <div class="pdp-acc">
                <button type="button" class="pdp-acc-head"><span>Shipping and Returns</span><span class="pdp-acc-icon" aria-hidden="true"></span></button>
                <div class="pdp-acc-body"><div class="pdp-acc-in">{{ section.settings.shipping_default }}</div></div>
              </div>
            {%- endif -%}
          </div>

        </div>
      </div>

    </div>
  </div>

  {%- comment -%} Store pickup popup {%- endcomment -%}
  <div class="pdp-pickup-modal" data-pickup-modal aria-hidden="true">
    <div class="pdp-pickup-overlay" data-pickup-close></div>
    <div class="pdp-pickup-box" role="dialog" aria-modal="true">
      <button type="button" class="pdp-pickup-x" data-pickup-close aria-label="Close">&times;</button>
      <h3 class="pdp-pickup-title">{{ section.settings.pickup_title | default: 'Store Pickup' }}</h3>
      <p class="pdp-pickup-address">{{ section.settings.pickup_address }}</p>
      {%- if section.settings.pickup_note != blank -%}<p class="pdp-pickup-note">{{ section.settings.pickup_note }}</p>{%- endif -%}
    </div>
  </div>
</section>

<style>
  

  @media (max-width: 991px) {
    #Pdp-{{ section.id }} .pdp-main { grid-template-columns: 1fr; gap: 30px; }
    #Pdp-{{ section.id }} .pdp-info { position: static; }
    #Pdp-{{ section.id }} .pdp-info-in { max-width: none; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('Pdp-{{ section.id }}');
    if (!root) return;

    /* ---- Variant selection ---- */
    var variantsEl = root.querySelector('[data-pdp-variants]');
    if (variantsEl) {
      var variants = JSON.parse(variantsEl.textContent);
      var selects = root.querySelectorAll('[data-pdp-option]');
      var idField = root.querySelector('[data-pdp-id]');
      var priceEl = root.querySelector('[data-pdp-price]');
      var atc = root.querySelector('.pdp-atc');
      var money = function (c) { return '$' + (c / 100).toFixed(2); };
      var onChange = function () {
        var chosen = Array.prototype.map.call(selects, function (s) { return s.value; });
        var match = variants.find(function (v) {
          return chosen.every(function (val, i) { return v.options[i] === val; });
        });
        if (!match) return;
        idField.value = match.id;
        if (priceEl) priceEl.textContent = money(match.price);
        if (atc) { atc.disabled = !match.available; atc.querySelector('span').textContent = match.available ? 'Add to cart' : 'Sold out'; }
      };
      selects.forEach(function (s) { s.addEventListener('change', onChange); });
    }

    /* ---- Accordions (single open) ---- */
    root.querySelectorAll('.pdp-acc-head').forEach(function (head) {
      head.addEventListener('click', function () {
        var acc = head.closest('.pdp-acc');
        var open = acc.classList.contains('active');
        root.querySelectorAll('.pdp-acc').forEach(function (a) { a.classList.remove('active'); });
        if (!open) acc.classList.add('active');
      });
    });

    /* ---- Store pickup popup ---- */
    var modal = root.querySelector('[data-pickup-modal]');
    function openModal() { if (modal) modal.classList.add('open'); }
    function closeModal() { if (modal) modal.classList.remove('open'); }
    root.querySelectorAll('.pdp-deliv').forEach(function (label) {
      label.addEventListener('click', function () {
        var input = label.querySelector('input');
        if (input && input.hasAttribute('data-delivery-pickup')) openModal();
      });
    });
    root.querySelectorAll('[data-pickup-close]').forEach(function (b) { b.addEventListener('click', closeModal); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

    /* ---- Complete your routine (recommendation) ---- */
    var upsell = root.querySelector('[data-upsell]');
    if (upsell) {
      var slot = upsell.querySelector('[data-upsell-slot]');
      var url = upsell.getAttribute('data-url') + '?section_id=product-upsell&product_id=' + upsell.getAttribute('data-product-id') + '&limit=1';
      fetch(url).then(function (r) { return r.text(); }).then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var content = doc.querySelector('[data-upsell-content]');
        if (content && content.innerHTML.trim()) { slot.innerHTML = content.innerHTML; }
        else { upsell.style.display = 'none'; }
      }).catch(function () { upsell.style.display = 'none'; });
    }
  })();
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "header", "content": "Store pickup" },
    { "type": "text", "id": "pickup_title", "label": "Pickup title", "default": "Store Pickup" },
    { "type": "textarea", "id": "pickup_address", "label": "Pickup address", "default": "491 Eglinton Avenue West, Suite 400, Toronto, Ontario, M5N 1A8" },
    { "type": "textarea", "id": "pickup_note", "label": "Pickup note" },
    { "type": "header", "content": "Shipping" },
    { "type": "text", "id": "ship_estimate", "label": "Ship estimate", "default": "Delivers 7 - 10 business days" },
    { "type": "richtext", "id": "shipping_default", "label": "Default shipping & returns text", "info": "Used when the product has no shipping_returns metafield." }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
