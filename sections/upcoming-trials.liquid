<section class="upcoming-trials" id="UCT-{{ section.id }}">

    <div class="container">
        <div class="uct-head heading center">
            {% if section.settings.highlight != blank %}
                <div class="subheading">
                    <p>{{ section.settings.highlight }}</p>
                </div>
            {% endif %}
            {% if section.settings.heading != blank %}
                <h2>{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.intro != blank %}
                <p class="uct-intro">{{ section.settings.intro }}</p>
            {% endif %}
        </div>

        <div class="uct-grid">
            {% for block in section.blocks %}
                <div class="uct-box" {{ block.shopify_attributes }}>
                    {% if block.settings.title != blank %}
                        <h3 class="uct-box-title">{{ block.settings.title }}</h3>
                    {% endif %}
                    {% if block.settings.text != blank %}
                        <div class="uct-box-text">{{ block.settings.text }}</div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>

    {% if section.settings.bg_image != blank %}
        <div class="uct-bg">
            <img src="{{ section.settings.bg_image | image_url: width: 2200 }}"
                 alt="{{ section.settings.bg_image.alt | escape }}" loading="lazy">
        </div>
    {% endif %}

    <div class="container">
        <div class="uct-form">
            <div class="uct-form-head">
                {% if section.settings.form_heading != blank %}
                    <h3 class="uct-form-title">{{ section.settings.form_heading }}</h3>
                {% endif %}
                {% if section.settings.form_subheading != blank %}
                    <p class="uct-form-sub">{{ section.settings.form_subheading }}</p>
                {% endif %}
            </div>

            {% form 'contact', class: 'ct-form-el' %}
                {% if form.posted_successfully? %}
                    <p class="ct-form-success">{{ section.settings.success_text | default: 'Thanks — we will be in touch.' }}</p>
                    {% if section.settings.thankyou_url != blank %}
                        <script>window.location.href = {{ section.settings.thankyou_url | json }};</script>
                    {% endif %}
                {% endif %}
                <input type="hidden" name="contact[form_type]" value="Upcoming clinical trial">

                <div class="ct-field-row">
                    <div class="ct-field">
                        <label>First Name*</label>
                        <input type="text" name="contact[first_name]" required>
                    </div>
                    <div class="ct-field">
                        <label>Last Name*</label>
                        <input type="text" name="contact[last_name]" required>
                    </div>
                </div>

                <div class="ct-field">
                    <label>Email</label>
                    <input type="email" name="contact[email]">
                </div>

                <div class="ct-field">
                    <label>Skin Condition</label>
                    <select name="contact[skin_condition]">
                        <option value="">Skin Condition</option>
                        {% for block in section.blocks %}
                            {% if block.settings.title != blank %}
                                <option value="{{ block.settings.title | escape }}">{{ block.settings.title }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>

                {% if section.settings.consent_one != blank %}
                    <label class="ct-consent">
                        <input type="checkbox" name="contact[consent_screening]" value="yes">
                        <span>{{ section.settings.consent_one }}</span>
                    </label>
                {% endif %}
                {% if section.settings.consent_two != blank %}
                    <label class="ct-consent">
                        <input type="checkbox" name="contact[consent_marketing]" value="yes">
                        <span>{{ section.settings.consent_two }}</span>
                    </label>
                {% endif %}

                {% comment %}
                  Spam / captcha placeholder — drop your widget here.
                  e.g. Shopify built-in: {% raw %}{{ form | captcha }}{% endraw %},
                  or a reCAPTCHA / hCaptcha / Turnstile div.
                {% endcomment %}
                <div class="ct-captcha"></div>

                <button type="submit" class="ct-submit">{{ section.settings.submit_label | default: 'Submit' }}</button>
            {% endform %}
        </div>
    </div>

</section>

{% schema %}
{
  "name": "Upcoming Trials",
  "settings": [
    { "type": "text", "id": "highlight", "label": "Highlight Text", "default": "Upcoming Trials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Upcoming Clinical Trials" },
    { "type": "textarea", "id": "intro", "label": "Intro paragraph" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Interested in participating in an upcoming clinical trial?" },
    { "type": "text", "id": "form_subheading", "label": "Form subheading", "default": "Fill the form below." },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Submit" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks — we will be in touch." },
    { "type": "url", "id": "thankyou_url", "label": "Redirect to page on success", "info": "e.g. your Thank You page. Leave blank to just show the success message." },
    { "type": "textarea", "id": "consent_one", "label": "Consent checkbox 1" },
    { "type": "textarea", "id": "consent_two", "label": "Consent checkbox 2" }
  ],
  "blocks": [
    {
      "type": "trial_box",
      "name": "Trial box",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Upcoming Trials",
      "blocks": [
        { "type": "trial_box" },
        { "type": "trial_box" },
        { "type": "trial_box" },
        { "type": "trial_box" },
        { "type": "trial_box" },
        { "type": "trial_box" }
      ]
    }
  ]
}
{% endschema %}
