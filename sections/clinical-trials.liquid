<section class="clinical-trials" id="CT-{{ section.id }}">

    <div class="container">
        <div class="ct-head heading center">
            {% if section.settings.highlight != blank %}
                <div class="subheading">
                    <p>{{ section.settings.highlight }}</p>
                </div>
            {% endif %}
            {% if section.settings.heading != blank %}
                <h2>{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.intro != blank %}
                <p class="ct-intro">{{ section.settings.intro }}</p>
            {% endif %}
        </div>

        {% if section.blocks.size > 0 %}
            <div class="ct-tabs">
                {% for block in section.blocks %}
                    <button type="button"
                            class="ct-tab {% if forloop.first %}active{% endif %}"
                            data-ct-tab="{{ forloop.index0 }}"
                            {{ block.shopify_attributes }}>
                        {{ block.settings.tab_label }}
                    </button>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="ct-panels">
        <div class="container-fluid">
            <div class="ctpanels-in">
                {% for block in section.blocks %}
                    <div class="ct-panel {% if forloop.first %}active{% endif %}" data-ct-panel="{{ forloop.index0 }}">

                        <div class="ct-left">
                            {% if block.settings.heading != blank %}
                                <h3 class="ct-panel-title">{{ block.settings.heading }}</h3>
                            {% endif %}
                            {% if block.settings.description != blank %}
                                <div class="ct-panel-desc">{{ block.settings.description }}</div>
                            {% endif %}
                            {% if block.settings.button_label != blank %}
                                <button type="button" class="custom-btn ct-btn black ct-join">{{ block.settings.button_label }}</button>
                            {% endif %}
                            <button type="button" class="custom-btn ct-btn black ct-back">&lsaquo; Go Back</button>
                            {% if block.settings.footer_text != blank or block.settings.popup_link_text != blank %}
                                <div class="ct-panel-foot">
                                    {{ block.settings.footer_text }}
                                    {% if block.settings.popup_link_text != blank %}
                                        <p class="ct-popup-trigger-wrap">
                                            <button type="button" class="ct-popup-trigger" data-ct-popup-open="{{ block.id }}">{{ block.settings.popup_link_text }}</button>
                                        </p>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="ct-right">

                            <div class="ct-cards">
                                {% for i in (1..4) %}
                                    {% assign label_key = 'card' | append: i | append: '_label' %}
                                    {% assign content_key = 'card' | append: i | append: '_content' %}
                                    {% assign card_label = block.settings[label_key] %}
                                    {% assign card_content = block.settings[content_key] %}
                                    {% if card_label != blank or card_content != blank %}
                                        <div class="ct-card">
                                            {% if card_label != blank %}
                                                <p class="ct-card-label">{{ card_label }}</p>
                                            {% endif %}
                                            {% if card_content != blank %}
                                                <div class="ct-card-content">{{ card_content }}</div>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>

                            <div class="ct-form">
                                {% if section.settings.form_heading != blank %}
                                    <h4 class="ct-form-title">{{ section.settings.form_heading }}</h4>
                                {% endif %}
                                {% form 'contact', class: 'ct-form-el' %}
                                    {% if form.posted_successfully? %}
                                        <p class="ct-form-success">{{ section.settings.success_text | default: 'Thanks — we will be in touch.' }}</p>
                                        {% if section.settings.thankyou_url != blank %}
                                            <script>window.location.href = {{ section.settings.thankyou_url | json }};</script>
                                        {% endif %}
                                    {% endif %}
                                    <input type="hidden" name="contact[trial]" value="{{ block.settings.tab_label }}">

                                    <div class="ct-field-row">
                                        <div class="ct-field">
                                            <input type="text" name="contact[first_name]" placeholder="First Name*" required>
                                        </div>
                                        <div class="ct-field">
                                            <input type="text" name="contact[last_name]" placeholder="Last Name*" required>
                                        </div>
                                    </div>

                                    <div class="ct-field">
                                        <input type="email" placeholder="Email" name="contact[email]">
                                    </div>

                                    <div class="ct-field" data-lenis-prevent>
                                        <input type="tel" class="ct-phone" placeholder="Phone Number">
                                        {% comment %} full international number is written here on submit {% endcomment %}
                                        <input type="hidden" name="contact[phone]">
                                    </div>

                                    <div class="ct-field">
                                        <select name="contact[skin_condition]">
                                            <option value="">Skin Condition</option>
                                            {% for b in section.blocks %}
                                                {% if b.settings.tab_label != blank %}
                                                    <option value="{{ b.settings.tab_label | escape }}" {% if b.id == block.id %}selected{% endif %}>{{ b.settings.tab_label }}</option>
                                                {% endif %}
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="form-consent">
                                        {% if section.settings.consent_one != blank %}
                                            <label class="ct-consent">
                                                <input type="checkbox" name="contact[consent_screening]" value="yes">
                                                <span>{{ section.settings.consent_one }}</span>
                                            </label>
                                        {% endif %}
                                        {% if section.settings.consent_two != blank %}
                                            <label class="ct-consent">
                                                <input type="checkbox" name="contact[consent_marketing]" value="yes">
                                                <span>{{ section.settings.consent_two }}</span>
                                            </label>
                                        {% endif %}
                                    </div>

                                    {% comment %}
                                    Spam / captcha placeholder — drop your widget here.
                                    e.g. Shopify's built-in: enable in Settings, then add
                                    {% raw %}{{ form | captcha }}{% endraw %}, or paste a
                                    reCAPTCHA/hCaptcha/Turnstile div inside this wrapper.
                                    {% endcomment %}
                                    <div class="ct-captcha"></div>

                                    <button type="submit" class="ct-submit custom-btn grey">{{ section.settings.submit_label | default: 'Submit' }}</button>
                                {% endform %}
                            </div>

                        </div>

                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {% for block in section.blocks %}
        {% assign has_popup = false %}
        {% if block.settings.popup_heading != blank or block.settings.popup_body != blank %}
            {% assign has_popup = true %}
        {% endif %}
        {% for i in (1..4) %}
            {% assign s_label = 'popup_stage' | append: i | append: '_label' %}
            {% if block.settings[s_label] != blank %}{% assign has_popup = true %}{% endif %}
        {% endfor %}
        {% if has_popup %}
            <div class="ct-popup" data-ct-popup="{{ block.id }}" aria-hidden="true">
                <div class="ct-popup-overlay" data-ct-popup-close></div>
                <div class="ct-popup-box" data-lenis-prevent role="dialog" aria-modal="true" aria-label="{{ block.settings.popup_heading | escape }}">
                    <button type="button" class="ct-popup-close" data-ct-popup-close>Close</button>
                    <div class="ct-popup-grid">
                        <div class="ct-popup-left" data-lenis-prevent>
                            {% if block.settings.popup_heading != blank %}
                                <h3 class="ct-popup-title">{{ block.settings.popup_heading }}</h3>
                            {% endif %}
                            {% if block.settings.popup_body != blank %}
                                <div class="ct-popup-body">{{ block.settings.popup_body }}</div>
                            {% endif %}
                        </div>
                        <div class="ct-popup-right" data-lenis-prevent>
                            {% for i in (1..4) %}
                                {% assign s_label = 'popup_stage' | append: i | append: '_label' %}
                                {% assign s_content = 'popup_stage' | append: i | append: '_content' %}
                                {% assign s_image = 'popup_stage' | append: i | append: '_image' %}
                                {% assign stage_label = block.settings[s_label] %}
                                {% assign stage_content = block.settings[s_content] %}
                                {% assign stage_image = block.settings[s_image] %}
                                {% if stage_label != blank or stage_content != blank or stage_image != blank %}
                                    <div class="ct-popup-stage">
                                        <div class="ct-popup-stage-text">
                                            {% if stage_label != blank %}
                                                <p class="ct-popup-stage-label">{{ stage_label }}</p>
                                            {% endif %}
                                            {% if stage_content != blank %}
                                                <div class="ct-popup-stage-content">{{ stage_content }}</div>
                                            {% endif %}
                                        </div>
                                        {% if stage_image != blank %}
                                            <div class="ct-popup-stage-img">
                                                <img src="{{ stage_image | image_url: width: 320 }}" alt="{{ stage_label | escape }}" width="140" height="140" loading="lazy">
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}

</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/css/intlTelInput.css">
<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/js/intlTelInput.min.js" defer></script>

<script>
  (function () {
    var root = document.getElementById('CT-{{ section.id }}');
    if (!root) return;
    var tabs = root.querySelectorAll('.ct-tab');
    var panels = root.querySelectorAll('.ct-panel');

    // ---- Phone field: intl-tel-input with flag / dial-code selector ----
    function initPhones() {
      if (typeof window.intlTelInput === 'undefined') { return setTimeout(initPhones, 60); }
      root.querySelectorAll('.ct-phone').forEach(function (input) {
        if (input.dataset.itiReady) return;
        input.dataset.itiReady = '1';
        var iti = window.intlTelInput(input, {
          initialCountry: 'ca',
          separateDialCode: true,
          utilsScript: 'https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/js/utils.js'
        });
        var form = input.closest('form');
        var hidden = form && form.querySelector('input[name="contact[phone]"]');
        if (form && hidden) {
          form.addEventListener('submit', function () {
            hidden.value = iti.getNumber(); // full +E.164 number
          });
        }
      });
    }
    initPhones();

    root.addEventListener('click', function (e) {
      // tab switching
      var tab = e.target.closest('.ct-tab');
      if (tab) {
        var index = tab.getAttribute('data-ct-tab');
        tabs.forEach(function (t) { t.classList.remove('active'); });
        panels.forEach(function (p) { p.classList.remove('active'); p.classList.remove('form-open'); });
        tab.classList.add('active');
        var panel = root.querySelector('.ct-panel[data-ct-panel="' + index + '"]');
        if (panel) panel.classList.add('active');
        return;
      }
      // open the form
      if (e.target.closest('.ct-join')) {
        e.target.closest('.ct-panel').classList.add('form-open');
        return;
      }
      // go back to the details
      if (e.target.closest('.ct-back')) {
        e.target.closest('.ct-panel').classList.remove('form-open');
        return;
      }
      // open a popup
      var opener = e.target.closest('[data-ct-popup-open]');
      if (opener) {
        var id = opener.getAttribute('data-ct-popup-open');
        var popup = root.querySelector('.ct-popup[data-ct-popup="' + id + '"]');
        if (popup) {
          popup.classList.add('open');
          popup.setAttribute('aria-hidden', 'false');
          document.body.classList.add('ct-popup-lock');
        }
        return;
      }
      // close a popup (overlay or close button)
      if (e.target.closest('[data-ct-popup-close]')) {
        var openPopup = e.target.closest('.ct-popup');
        if (openPopup) closePopup(openPopup);
        return;
      }
    });

    function closePopup(popup) {
      popup.classList.remove('open');
      popup.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('ct-popup-lock');
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        var open = root.querySelector('.ct-popup.open');
        if (open) closePopup(open);
      }
    });

    // if a form was just submitted, keep that panel's form view open
    var submitted = root.querySelector('.ct-form-success');
    if (submitted) {
      var openPanel = submitted.closest('.ct-panel');
      if (openPanel) openPanel.classList.add('form-open');
    }
  })();
</script>

{% schema %}
{
  "name": "Clinical Trials",
  "settings": [
    { "type": "text", "id": "highlight", "label": "Highlight Text", "default": "Clinical Trials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recruiting Clinical Trials" },
    { "type": "textarea", "id": "intro", "label": "Intro paragraph" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Fill Out The Clinical Trial Form" },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Submit" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks — we will be in touch." },
    { "type": "url", "id": "thankyou_url", "label": "Redirect to page on success", "info": "e.g. your Thank You page. Leave blank to just show the success message." },
    { "type": "textarea", "id": "consent_one", "label": "Consent checkbox 1" },
    { "type": "textarea", "id": "consent_two", "label": "Consent checkbox 2" }
  ],
  "blocks": [
    {
      "type": "trial",
      "name": "Trial",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab label" },
        { "type": "header", "content": "Left column" },
        { "type": "text", "id": "heading", "label": "Trial title" },
        { "type": "richtext", "id": "description", "label": "Description" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the trial" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "richtext", "id": "footer_text", "label": "Footer text" },
        { "type": "header", "content": "Info card 1" },
        { "type": "text", "id": "card1_label", "label": "Card 1 label" },
        { "type": "richtext", "id": "card1_content", "label": "Card 1 content" },
        { "type": "header", "content": "Info card 2" },
        { "type": "text", "id": "card2_label", "label": "Card 2 label" },
        { "type": "richtext", "id": "card2_content", "label": "Card 2 content" },
        { "type": "header", "content": "Info card 3" },
        { "type": "text", "id": "card3_label", "label": "Card 3 label" },
        { "type": "richtext", "id": "card3_content", "label": "Card 3 content" },
        { "type": "header", "content": "Info card 4" },
        { "type": "text", "id": "card4_label", "label": "Card 4 label" },
        { "type": "richtext", "id": "card4_content", "label": "Card 4 content" },

        { "type": "header", "content": "Learn More popup" },
        { "type": "text", "id": "popup_link_text", "label": "Footer link text", "info": "The clickable link shown in the footer that opens the popup. Leave blank to hide." },
        { "type": "text", "id": "popup_heading", "label": "Popup heading" },
        { "type": "richtext", "id": "popup_body", "label": "Popup text", "info": "Supports paragraphs and bullet lists." },
        { "type": "header", "content": "Popup stage 1" },
        { "type": "text", "id": "popup_stage1_label", "label": "Stage 1 label" },
        { "type": "richtext", "id": "popup_stage1_content", "label": "Stage 1 text" },
        { "type": "image_picker", "id": "popup_stage1_image", "label": "Stage 1 image" },
        { "type": "header", "content": "Popup stage 2" },
        { "type": "text", "id": "popup_stage2_label", "label": "Stage 2 label" },
        { "type": "richtext", "id": "popup_stage2_content", "label": "Stage 2 text" },
        { "type": "image_picker", "id": "popup_stage2_image", "label": "Stage 2 image" },
        { "type": "header", "content": "Popup stage 3" },
        { "type": "text", "id": "popup_stage3_label", "label": "Stage 3 label" },
        { "type": "richtext", "id": "popup_stage3_content", "label": "Stage 3 text" },
        { "type": "image_picker", "id": "popup_stage3_image", "label": "Stage 3 image" },
        { "type": "header", "content": "Popup stage 4" },
        { "type": "text", "id": "popup_stage4_label", "label": "Stage 4 label" },
        { "type": "richtext", "id": "popup_stage4_content", "label": "Stage 4 text" },
        { "type": "image_picker", "id": "popup_stage4_image", "label": "Stage 4 image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clinical Trials",
      "blocks": [
        { "type": "trial" },
        { "type": "trial" },
        { "type": "trial" }
      ]
    }
  ]
}
{% endschema %}
