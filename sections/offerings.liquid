<section class="offering">
    <div class="container">
        <div class="heading center">
            {% if section.settings.highlight != blank %}
                <div class="subheading">
                    <p>{{ section.settings.highlight }}</p>
                </div>
            {% endif %}
            {% if section.settings.heading != blank %}
                <h2>{{ section.settings.heading }}</h2>
            {% endif %}
        </div>
    </div>

    <div class="offering-scroll" id="OfferingScroll-{{ section.id }}">
        <button type="button" class="os-arrow os-arrow--prev" aria-label="Previous" disabled>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <button type="button" class="os-arrow os-arrow--next" aria-label="Next">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg>
        </button>
        <div class="os-track">
            {% for block in section.blocks %}
                <div class="os-item" {{ block.shopify_attributes }}>
                    <div class="os-card os-text">
                        <div class="oc-text-top">
                            {% if block.settings.title != blank %}
                                <h3>{{ block.settings.title }}</h3>
                            {% endif %}
                            {% if block.settings.text != blank %}
                                <p class="os-desc">{{ block.settings.text }}</p>
                            {% endif %}
                        </div>
                        <div class="os-text-bottom">
                            {% if block.settings.services != blank %}
                                <div class="os-services">
                                    <span class="os-services__label">{{ block.settings.services_label | default: 'Services :' }}</span>
                                    <ul>
                                        {% assign service_lines = block.settings.services | newline_to_br | split: '<br />' %}
                                        {% for line in service_lines %}
                                            {% assign clean = line | strip %}
                                            {% if clean != blank %}<li>{{ clean }}</li>{% endif %}
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="os-card os-image">
                        {% if block.settings.image != blank %}
                            <img src="{{ block.settings.image | image_url: width: 800 }}"
                                 alt="{{ block.settings.title | escape }}"
                                 width="{{ block.settings.image.width }}"
                                 height="{{ block.settings.image.height }}"
                                 loading="lazy">
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<script>
  (function () {
    var root = document.getElementById('OfferingScroll-{{ section.id }}');
    if (!root) return;
    var scroller = root.querySelector('.os-track');
    if (!scroller) return;
    var prev = root.querySelector('.os-arrow--prev');
    var next = root.querySelector('.os-arrow--next');

    // drag-to-scroll for desktop mouse users
    var down = false, startX, startLeft;
    scroller.addEventListener('mousedown', function (e) {
      down = true; scroller.classList.add('is-dragging');
      startX = e.pageX; startLeft = scroller.scrollLeft;
    });
    window.addEventListener('mouseup', function () { down = false; scroller.classList.remove('is-dragging'); });
    scroller.addEventListener('mouseleave', function () { down = false; scroller.classList.remove('is-dragging'); });
    scroller.addEventListener('mousemove', function (e) {
      if (!down) return;
      e.preventDefault();
      scroller.scrollLeft = startLeft - (e.pageX - startX);
    });

    // ---- arrow navigation ----
    function step() {
      var item = scroller.querySelector('.os-item');
      var gap = parseFloat(getComputedStyle(scroller).columnGap || getComputedStyle(scroller).gap) || 24;
      return item ? item.getBoundingClientRect().width + gap : scroller.clientWidth * 0.8;
    }
    function maxScroll() {
      return scroller.scrollWidth - scroller.clientWidth;
    }
    function updateArrows() {
      var max = maxScroll();
      var atStart = scroller.scrollLeft <= 1;
      var atEnd = scroller.scrollLeft >= max - 1;
      var noScroll = max <= 1; // everything fits, nothing to scroll
      if (prev) prev.disabled = atStart;
      if (next) next.disabled = atEnd || noScroll;
      root.classList.toggle('os-no-scroll', noScroll);
    }
    if (prev) prev.addEventListener('click', function () {
      scroller.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    if (next) next.addEventListener('click', function () {
      scroller.scrollBy({ left: step(), behavior: 'smooth' });
    });
    scroller.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    window.addEventListener('load', updateArrows);
    updateArrows();
  })();
</script>

{% schema %}
{
  "name": "Offerings",
  "settings": [
    { "type": "text", "id": "highlight", "label": "Highlight Text", "default": "Offerings" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Serving your Skin Needs" }
  ],
  "blocks": [
    {
      "type": "offering",
      "name": "Offering",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "text", "id": "services_label", "label": "Services label", "default": "Services :" },
        { "type": "textarea", "id": "services", "label": "Services (one per line)" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Offerings",
      "blocks": [
        { "type": "offering" },
        { "type": "offering" },
        { "type": "offering" },
        { "type": "offering" }
      ]
    }
  ]
}
{% endschema %}
