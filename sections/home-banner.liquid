<section class="banner home">
    <div class="bg-image">
        <picture>
            {% if section.settings.banner_bg_mobile != blank %}
                <source media="(max-width: 767px)" srcset="{{ section.settings.banner_bg_mobile | img_url: 'master' }}">
            {% endif %}
            <img src="{{ section.settings.banner-bg | image_url }}" alt="banner image">
        </picture>
    </div>
    <div class="banner-in">
        <div class="container">
            <div class="banner-content">
                <div class="bc-top">
                    <div class="bct-image">
                        <img src="{{ section.settings.banner-image | image_url }}" alt="banner logo">
                    </div>
                </div>
                <div class="bc-bottom">
                    <div class="bcb-content">
                        <h1>{{ section.settings.head }}</h1>
                        <p>{{ section.settings.para }}</p>
                        <div class="bcth-button" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
                            <a href="{{ section.settings.button_link | default: '#' }}" class="custom-btn filled">{{ section.settings.button_text }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Home Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner-bg",
      "label": "Banner Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "banner_bg_mobile",
      "label": "Banner Image (Mobile)"
    },
    {
      "type": "image_picker",
      "id": "banner-image",
      "label": "Banner Logo Image"
    },
    {
      "type": "text",
      "id": "head",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "para",
      "label": "Paragraph"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    { "name": "Home Banner" }
  ]
}
{% endschema %}
