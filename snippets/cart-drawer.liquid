{% comment %}
  Side cart drawer. Rendered once in theme.liquid.
  Items are populated/refreshed by cart-drawer.js from /cart.js.
{% endcomment %}

<div class="cart-drawer" id="CartDrawer" aria-hidden="true"
     data-recommend-url="{{ routes.product_recommendations_url }}">
  <div class="cart-drawer__overlay" data-cart-close></div>

  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Shopping cart">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">Your cart (<span data-ajax-cart-bind="item_count">{{ cart.item_count }}</span>)</h2>
      <button class="cart-drawer__close" type="button" data-cart-close aria-label="Close cart">
        <img src="https://cdn.shopify.com/s/files/1/0886/1895/8882/files/close-icon.svg?v=1784231950" alt="">
      </button>
    </div>

    <div class="cart-drawer__body" data-lenis-prevent>
      <div class="cart-drawer__items" data-cart-items>
        {% comment %} Populated by cart-drawer.js {% endcomment %}
      </div>
      <p class="cart-drawer__empty" data-cart-empty hidden>Your cart is empty.</p>

      <div class="cart-drawer__routine" data-cart-routine hidden>
        <p class="cart-drawer__routine-title">Complete your routine</p>
        <div class="cart-drawer__routine-slot" data-cart-upsell></div>
      </div>
    </div>

    <div class="cart-drawer__loader" aria-hidden="true">
      <span class="cart-drawer__spinner"></span>
    </div>

    <footer class="cart-drawer__footer" data-cart-footer hidden>
      <div class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <span data-cart-subtotal>{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-drawer__note">Tax included and shipping and discounts calculated at checkout.</p>

      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="cart-drawer__checkout">Checkout</button>
      </form>

      {%- if shop.enabled_payment_types.size > 0 -%}
        <div class="cart-drawer__payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'cart-pay-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </footer>
  </aside>
</div>
